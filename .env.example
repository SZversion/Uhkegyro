# 실제 값은 .env에만 적으세요 (커밋 금지). 이 파일은 필요한 키 목록만 공유하는 용도입니다.

# ── LLM ─────────────────────────────────────────────
# OpenRouter 권장: 키 하나로 여러 회사 모델을 같은 코드로 부를 수 있어
# 축 ②가 요구하는 "2개 이상 모델 비교"가 쉬워집니다.
OPENROUTER_API_KEY=
# 직접 호출을 쓴다면
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Langfuse (필수 조건 4: 트레이싱·평가) ──────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ── DB ──────────────────────────────────────────────
# 로컬/운영 공통: Neon PostgreSQL 사용
# 로컬: Neon dev 브랜치 연결 문자열 (운영과 동일 환경, 브랜칭 기능 활용)
# 운영: Neon production 브랜치 연결 문자열
# Neon 콘솔(https://console.neon.tech) > 프로젝트 > Connection Details > psql 탭
# 형식: postgresql+asyncpg://user:password@ep-xxx.ap-northeast-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.ap-northeast-1.aws.neon.tech/dbname?sslmode=require

# ── TERM_CARD 카탈로그 ──────────────────────────────
# TERM_CARD 디렉터리 경로 (미설정 시 자동 탐지)
# Docker: /app/term-cards (Dockerfile에서 복사됨)
# 로컬: 레포 루트/docs/domains/illustration-reference/term-cards/
TERM_CARDS_PATH=

# ── 프롬프트 경로 (API 서비스) ─────────────────────
# 필수. 설정이 비어 있으면 저장소 고정 경로로 폴백하지 않고
# 어댑터 초기화 단계에서 PromptConfigurationError로 실패한다.
# Docker 이미지 내부 경로와 반드시 일치: /app/prompts/uhkegryo-interpreter-v0.md
# 로컬 개발: 아래 값
INTERPRETER_PROMPT_PATH=./prompts/uhkegryo-interpreter-v0.md

# ── MCP ─────────────────────────────────────────────
# MCP 도구 활성화 (기본 false, 실제 도구 준비 후 true로 변경)
# 로컬에서 docker compose --profile mcp up 시 별도 포트 8001로 실행
MCP_ENABLED=false